#!/usr/bin/env perl
use strict;
use warnings;

use Test::More;
use Math::Prime::Util::GMP qw/legendre_phi/;

my @legendre_sums = (
  [ 0,  92372, 0],
  [ 5,  15, 1],
  [100, 25, 1],
  [ 89, 4, 21 ],
  [ 46, 4, 11 ],
  [ 47, 4, 12 ],
  [ 48, 4, 12 ],
  [ 52, 4, 12 ],
  [ 53, 4, 13 ],
  [10000, 5, 2077],
  [526, 7, 95],
  [588, 6, 111],
  [100000, 5, 20779],
  [5882, 6, 1128],
  [100000, 7, 18053],
  [10000, 8, 1711],
  [1000000, 168, 78331],
  [800000, 213, 63739],
  [4000, 255, 296],
  [54321, 5, 11287],
  [100, 10, 16],
  ["100000000000000000000", 0, "100000000000000000000"],
  ["100000000000000000000", 1, "50000000000000000000"],
  ["100000000000000000000", 21, "12604702722008478395"],
  ["100000000000000000000", 35, "11061792201035863441"],
  ["18446744073709551615", 25, "2219462265033335956"],
  ["18446744073709551616", 25, "2219462265033335956"],
  ["1000000000000000000000000000000",
   "1000000000000000000000000000000", 1],
);

plan tests => scalar(@legendre_sums);

for my $t (@legendre_sums) {
  my($n, $a, $exp) = @$t;
  is(legendre_phi($n, $a), $exp, "legendre_phi($n,$a) = $exp");
}
